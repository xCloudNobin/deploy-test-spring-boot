# --- HTTP server ---------------------------------------------------------
# Port to bind.
PORT=8080
# Address to bind (use 127.0.0.1 for local-only, 0.0.0.0 for containers).
BIND_HOST=0.0.0.0

# --- Persistence ---------------------------------------------------------
# Directory below which the SQLite database file lives. Mount/point this at a
# durable volume so data survives redeploys (this path must be in persistent
# storage, never only inside an ephemeral release directory).
DATA_DIR=./data

# Optional full override of the JDBC URL used by the app.
# DB_URL=jdbc:sqlite:/var/lib/taskboard/taskboard.db

# --- Release marker --------------------------------------------------------
# Overrides the auto-detected (git SHA) release marker shown in /api/meta and
# the UI footer.
# BUILD_MARKER=my-deploy-revision